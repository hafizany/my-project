            if (acceptedFiles.length !== selectedFiles.length) {
                showToast('Pilih fail PDF atau gambar PNG/JPG/GIF/WebP yang tidak melebihi 50 MB.');
            }
            acceptedFiles.forEach(file => attachments.push({
                name: file.name,
                fileType: file.type,
                file
            }));
            renderPreviews();
            return acceptedFiles.length;
        }

