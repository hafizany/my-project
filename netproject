        function printJFDocument() {
            const printArea = document.getElementById('jf-print-area');
            if (!printArea) return;

            const printWindow = window.open('', '_blank', 'width=1200,height=900');
            if (!printWindow) {
                showToast('Popup diblokir. Sila benarkan pop-up untuk cetak JF.');
                return;
            }

            const clone = printArea.cloneNode(true);
            clone.querySelectorAll('[contenteditable]').forEach(element => {
                element.textContent = element.innerText;
                element.removeAttribute('contenteditable');
            });
            const styles = document.getElementById('jf-form-styles').textContent;
            printWindow.document.write(`<!DOCTYPE html><html><head><style>
                @page { size: A4 landscape; margin: 0; }
                body { margin: 0; }
                ${styles}
                .jf-paper { height: 210mm; overflow: hidden; }
                .jf-content { transform-origin: top left; }
            </style></head><body>${clone.outerHTML}</body></html>`);
            printWindow.document.close();
            printWindow.focus();
            const paper = printWindow.document.querySelector('.jf-paper');
            const content = paper.querySelector('.jf-content');
            const paperStyle = printWindow.getComputedStyle(paper);
            const availableHeight = paper.clientHeight - parseFloat(paperStyle.paddingTop) - parseFloat(paperStyle.paddingBottom);
            const scale = Math.min(1, availableHeight / content.scrollHeight);
            content.style.transform = `scale(${scale})`;
            printWindow.print();
        }

