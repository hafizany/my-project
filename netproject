        function openProjectAttachment(projectId, category, attachmentIndex) {
            const project = allProjects.find(item => item.id === Number(projectId));
            if (!project) {
                showToast('Rekod projek tidak ditemui.');
                return;
            }

            const attachments = category === 'picture'
                ? parsePictureList(project.picture)
                : category === 'preapp'
                    ? project.preappAttachments || []
                    : category === 'quo'
                        ? project.quoAttachments || []
                        : category === 'jf'
                            ? project.jfAttachments || []
                            : category === 'preport'
                                ? project.pReportAttachments || []
                            : category === 'ins'
                                ? project.insAttachments || []
                        : category.startsWith('status:')
                            ? (project.statusAttachments || {})[category.slice('status:'.length)] || []
                        : [];
            const attachment = attachments[Number(attachmentIndex)];
            if (!attachment) return;

            if (typeof attachment !== 'string') {
                openAttachment(attachment);
                return;
            }
            if (/^data:application\/pdf;base64,/i.test(attachment)) {
                openPdfAttachment({ name: `PDF ${Number(attachmentIndex) + 1}`, dataUrl: attachment });
            } else if (/\.pdf(?:$|[?#])/i.test(attachment)) {
                openPdfAttachment({ name: `PDF ${Number(attachmentIndex) + 1}`, fileUrl: attachment });
            } else {
                openPictureViewer(attachment);
            }
        }

