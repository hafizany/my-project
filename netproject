                document.head.appendChild(s);
                return;
            }
            var counts = {};
            STATUS_LIST.forEach(function(s){ counts[s]=0; });
            allProjects.forEach(function(p){ var s=(p.status||'').toUpperCase(); if (counts[s]!==undefined) counts[s]++; });
            var statusData = STATUS_LIST.map(function(s){ return counts[s]; });
            var statusColors = ['#3498db','#9b59b6','#f39c12','#e74c3c','#16a085','#7f8c8d','#8e44ad','#27ae60'];
            var ctx1 = document.getElementById('dashStatusChart');
            if (ctx1) {
                if (dashStatusChart) dashStatusChart.destroy();
                dashStatusChart = new Chart(ctx1, { type:'bar', data:{ labels: STATUS_LIST, datasets:[{label:'Projects', data: statusData, backgroundColor: statusColors, borderRadius:6}] }, options:{ plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true,ticks:{precision:0}}}, onClick:function(e,els){ if(els.length){ selectedContractors = null; filterByCard(STATUS_LIST[els[0].index]); switchView('projects'); } } } });
            }
            var monthCounts = {};
            allProjects.forEach(function(p){ var ym = extractYearMonth(p.poDate); if (ym && ym.year && ym.month){ var k = ym.year+'-'+ym.month; monthCounts[k]=(monthCounts[k]||0)+1; } });
            var keys = Object.keys(monthCounts).sort();
            var years = Array.from(new Set(keys.map(function(k){ return k.slice(0, 4); }))).sort();
            var yearSelect = document.getElementById('dash-month-year-filter');
            var selectedYear = yearSelect ? yearSelect.value : '';
            if (yearSelect) {
                yearSelect.innerHTML = years.length
                    ? '<option value="ALL">All Years</option>' + years.map(function(year){ return '<option value="' + year + '">' + year + '</option>'; }).join('')
                    : '<option value="">No years available</option>';
                if (years.length) {
                    if (selectedYear !== 'ALL' && years.indexOf(selectedYear) === -1) selectedYear = years[years.length - 1];
                    yearSelect.value = selectedYear;
                } else {
                    selectedYear = '';
                    yearSelect.value = '';
                }
            }
            var monthTotals = {};
            keys.forEach(function(k) {
                var year = k.slice(0, 4);
                var month = k.slice(5, 7);
                if (selectedYear === 'ALL' || year === selectedYear) {
                    monthTotals[month] = (monthTotals[month] || 0) + monthCounts[k];
                }
            });
            var months = ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'];
            var monthLabels = { '01':'Jan', '02':'Feb', '03':'Mac', '04':'Apr', '05':'Mei', '06':'Jun', '07':'Jul', '08':'Ogo', '09':'Sep', '10':'Okt', '11':'Nov', '12':'Dis' };
            var ctx2 = document.getElementById('dashMonthChart');
            if (ctx2) {
                if (dashMonthChart) dashMonthChart.destroy();
                dashMonthChart = new Chart(ctx2, {
                    type: 'bar',
                    data: {
                        labels: months.map(function(month){ return monthLabels[month]; }),
                        datasets: [{
                            label: 'Projects',
                            data: months.map(function(month){ return monthTotals[month] || 0; }),
                            backgroundColor: '#002b5c',
                            borderRadius: 6,
                            maxBarThickness: 36
                        }]
                    },
                    options: {
                        layout: { padding: { top: 16 } },
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
                        onClick: function(event, elements) {
                            if (!elements.length) return;
                            const month = months[elements[0].index];
                            showProjectsForPoMonth(selectedYear === 'ALL' ? '' : selectedYear, month);
                        }
                    },
                    plugins: [{
                        id: 'month-bar-value-labels',
                        afterDatasetsDraw: function(chart) {
                            var ctx = chart.ctx;
                            var dataset = chart.data.datasets[0];
                            var bars = chart.getDatasetMeta(0).data;
                            ctx.save();
                            ctx.font = '600 11px ui-sans-serif, system-ui, sans-serif';
                            ctx.fillStyle = '#002b5c';
                            ctx.textAlign = 'center';
                            bars.forEach(function(bar, index) {
                                var position = bar.getProps(['x', 'y'], true);
                                ctx.fillText(String(dataset.data[index]), position.x, position.y - 6);
