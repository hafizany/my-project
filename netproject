        function openAttachment(attachment) {
            if (attachment.fileUrl && isUploadedAttachmentUrl(attachment.fileUrl)) {
                if (isImageAttachment(attachment)) {
                    openPictureViewer(attachment.fileUrl);
                    return;
                }
                const openedWindow = window.open(attachment.fileUrl, '_blank');
                if (!openedWindow) {
                    showToast('Benarkan pop-up untuk membuka lampiran.');
                    return;
                }
                openedWindow.opener = null;
                return;
            }
            if (attachment.dataUrl && /^data:image\//i.test(attachment.dataUrl)) {
                openPictureViewer(attachment.dataUrl);
                return;
            }
            openPdfAttachment(attachment);
        }

        function openPdfAttachment(attachment) {
            if (attachment.fileUrl && isUploadedAttachmentUrl(attachment.fileUrl)) {
                const openedWindow = window.open(attachment.fileUrl, '_blank');
                if (!openedWindow) showToast('Benarkan pop-up untuk membuka fail PDF.');
                else openedWindow.opener = null;
                return;
            }
            const binary = atob(attachment.dataUrl.split(',')[1] || '');
            const bytes = new Uint8Array(binary.length);
            for (let index = 0; index < binary.length; index += 1) {
                bytes[index] = binary.charCodeAt(index);
            }
            const url = URL.createObjectURL(new Blob([bytes], { type: 'application/pdf' }));
            const openedWindow = window.open(url, '_blank');
            if (!openedWindow) {
                URL.revokeObjectURL(url);
                showToast('Benarkan pop-up untuk membuka fail PDF.');
                return;
            }
            openedWindow.opener = null;
            window.setTimeout(() => URL.revokeObjectURL(url), 60000);
        }

