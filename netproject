        function wfOpenQuotation() {
            const project = wfGetProject();
            if (!project) {
                showToast('No project selected.');
                return;
            }
            const attachments = [
                ...(project.quoAttachments || []).map((attachment, index) => ({ attachment, index, category: 'quo' })),
                ...((project.statusAttachments || {}).QUO || []).map((attachment, index) => ({ attachment, index, category: 'status:QUO' }))
            ];
            if (!attachments.length) {
                showToast('No quotation attachments available.');
                return;
            }
            if (attachments.length === 1) {
                openProjectAttachment(project.id, attachments[0].category, attachments[0].index);
                return;
            }
            const list = document.getElementById('wf-quotation-list');
            const button = document.getElementById('wf-quotation-button');
            if (!list.classList.contains('hidden')) {
                list.classList.add('hidden');
                button.setAttribute('aria-expanded', 'false');
                return;
            }
            list.replaceChildren();
            attachments.forEach(({ attachment, index, category }, position) => {
                const link = document.createElement('button');
                link.type = 'button';
                link.className = 'block w-full text-left text-xs text-emerald-700 hover:underline break-all';
                link.textContent = attachment.name || `Quotation ${position + 1}`;
                link.addEventListener('click', () => openProjectAttachment(project.id, category, index));
                list.appendChild(link);
            });
            list.classList.remove('hidden');
            button.setAttribute('aria-expanded', 'true');
        }

        function renderWorkflowView() {
            document.getElementById('wf-quotation-list').classList.add('hidden');
            document.getElementById('wf-quotation-button').setAttribute('aria-expanded', 'false');
            var p = wfGetProject();
            var sum = document.getElementById('wf-case-summary');
            var tl = document.getElementById('wf-timeline');
            var docs = document.getElementById('wf-docs');
            var val = document.getElementById('wf-validation');
            var badge = document.getElementById('wf-status-badge');
            if (!p) { if(sum) sum.innerHTML='<div class="text-gray-500">No project data.</div>'; if(tl) tl.innerHTML=''; if(docs) docs.innerHTML=''; if(val) val.innerHTML=''; return; }
            if (badge) badge.innerHTML = getStatusBadge(p.status);
            var row = function(label, value, icon){ return '<div class="text-gray-700"><i class="fa-solid '+icon+' w-4 text-gray-400 mr-1"></i><span class="text-gray-500">'+label+':</span> <span class="font-medium">'+escapeHtml(jfDisplayValue(value)||'-')+'</span></div>'; };
            if (sum) sum.innerHTML =
              '<div class="font-semibold text-sm mb-1">'+escapeHtml(p.description||'-')+'</div>' +
              row('Location', p.location, 'fa-location-dot') +
              row('Asset', p.asset, 'fa-box') +
              row('Enq', (p.enq||'') + (p.date && p.date!=='-' ? ' \u00B7 '+p.date : ''), 'fa-hashtag') +
              row('Contractor', p.con, 'fa-helmet-safety') +
              row('Value', 'RM ' + formatCurrency(p.value||0), 'fa-coins') +
              row('Not', p.not, 'fa-clipboard') +
              row('Order', p.order, 'fa-file-lines') +
              row('PR', p.pr, 'fa-file-circle-check') +
              row('PO', p.po, 'fa-file-invoice') +
              '<div class="mt-1 grid gap-1">' +
              '<div class="rounded bg-gray-50 px-2 py-1.5 text-[10px] text-gray-600"><div class="font-semibold text-gray-700 mb-0.5">Justification</div><div class="wf-remark-text">'+escapeHtml(jfDisplayValue(p.justificationForRepair)||'\u2014')+'</div></div>' +
              '<div class="rounded bg-amber-50 px-2 py-1.5 text-[10px] text-gray-600"><div class="font-semibold text-gray-700 mb-0.5">Remark</div><div class="wf-remark-text">'+escapeHtml(jfDisplayValue(p.remark)||'\u2014')+'</div></div>' +
              '</div>';

            var has = function(v){ return v && String(v).trim() && String(v).trim() !== '-'; };
            var workflowAttachments = function(category, attachments){
              return (attachments||[]).map(function(attachment,index){
                return { category:category, index:index, name:typeof attachment==='string'?'Attachment '+(index+1):(attachment.name||'Attachment '+(index+1)) };
              });
            };
            var workflowStatusAttachments = function(status){
              return workflowAttachments('status:'+status,(p.statusAttachments||{})[status]);
            };
            var steps = [
              { name:'Enquiry Received', done: has(p.enq) || has(p.date), detail: [p.enq, p.enqType, p.date].filter(has).join(' \u00B7 ') },
              { name:'Site Visit', done: has(p.siteVisitDate), detail: has(p.siteVisitDate) ? p.siteVisitDate : '', attachments: workflowAttachments('picture',parsePictureList(p.picture||'')) },
              { name:'Quotation', done: has(p.quo) || (p.quoAttachments&&p.quoAttachments.length), detail: [p.quo, p.quoDate, (p.quoAttachments&&p.quoAttachments.length)?(p.quoAttachments.length+' attachment(s)'):''].filter(has).join(' \u00B7 '), attachments: workflowAttachments('quo',p.quoAttachments).concat(workflowStatusAttachments('QUO')) },
              { name:'PreApp', done: has(p.preappRef) || (p.preappAttachments&&p.preappAttachments.length), detail: [p.preappRef, p.preappDate, (p.preappAttachments&&p.preappAttachments.length)?(p.preappAttachments.length+' attachment(s)'):''].filter(has).join(' \u00B7 '), attachments: workflowAttachments('preapp',p.preappAttachments).concat(workflowStatusAttachments('PREAPP')) },
              { name:'JF / Justification', done: has(p.jfRef) || (p.jfAttachments&&p.jfAttachments.length) || has(p.justificationForRepair), detail: [p.jfRef, (p.jfAttachments&&p.jfAttachments.length)?(p.jfAttachments.length+' attachment(s)'):''].filter(has).join(' \u00B7 '), attachments: workflowAttachments('jf',p.jfAttachments).concat(workflowStatusAttachments('JF')) },
              { name:'PR', done: has(p.pr) || has(p.prDate), detail: [p.pr, p.prDate].filter(has).join(' \u00B7 '), attachments: workflowAttachments('pr',p.prAttachments).concat(workflowStatusAttachments('PR')) },
              { name:'PO', done: has(p.po) || has(p.poDate), detail: [p.po, p.poDate].filter(has).join(' \u00B7 '), attachments: workflowStatusAttachments('PO').concat(workflowStatusAttachments('TENDER')) },
              { name:'Kick Off Meeting', done: has(p.kickoffMeetingDate), detail: has(p.kickoffMeetingDate) ? p.kickoffMeetingDate : '' },
              { name:'Work Start', done: has(p.start), detail: has(p.start) ? p.start : '', attachments: workflowStatusAttachments('WOP') },
              { name:'Work Finish', done: has(p.finish), detail: has(p.finish) ? p.finish : '' },
              { name:'Sign Off', done: has(p.signoffDate), detail: has(p.signoffDate) ? p.signoffDate : '', attachments: workflowStatusAttachments('DONE') },
              { name:'Close (DONE)', done: (p.status||'').toUpperCase()==='DONE', detail: (p.status||'').toUpperCase()==='DONE' ? 'Marked DONE' : ('Current: '+(p.status||'-')), attachments: workflowStatusAttachments('DONE') }
            ];
            if (tl) tl.innerHTML = steps.map(function(s,i){
              var done = s.done;
              var dot = done ? 'bg-green-600 text-white' : 'bg-gray-200 text-gray-600';
              var icon = done ? '<i class="fa-solid fa-check"></i>' : (i+1);
              var line = i < steps.length-1 ? '<div class="wf-line"></div>' : '';
              var stBadge = done ? '<span class="inline-flex items-center px-1.5 py-0 rounded-full text-[10px] font-semibold bg-green-100 text-green-700 ml-1">Done</span>' : '<span class="inline-flex items-center px-1.5 py-0 rounded-full text-[10px] font-semibold bg-gray-100 text-gray-600 ml-1">Pending</span>';
              var attachmentIcons = (s.attachments||[]).map(function(attachment){
                var label = escapeHtml(attachment.name);
                return '<button type="button" class="ml-1 text-gray-500 hover:text-blue-700" title="Open attachment: '+label+'" aria-label="Open attachment: '+label+'" onclick="openProjectAttachment('+p.id+',\''+attachment.category+'\','+attachment.index+')"><i class="fa-solid fa-paperclip" aria-hidden="true"></i></button>';
              }).join('');
              return '<div class="wf-step"><div><div class="wf-dot '+dot+'">'+icon+'</div>'+line+'</div><div class="pb-2 min-w-0"><div class="text-xs font-semibold">'+escapeHtml(s.name)+' '+stBadge+attachmentIcons+'</div><div class="text-xs text-gray-500 break-words">'+escapeHtml(s.detail||'\u2014')+'</div></div></div>';
            }).join('');

            var picAtt = parsePictureList(p.picture||'');
            var claimAtt = (p.statusAttachments||{}).DONE || [];
            var docItem = function(name, icon, color, fileExists, detail, links){
              var fileStatus = '<i class="fa-solid fa-circle-check '+(fileExists?'text-green-600':'text-gray-400')+' text-[10px]" aria-label="'+(fileExists?'File available':'No file')+'" title="'+(fileExists?'File available':'No file')+'"></i>';
              return '<div class="py-2 flex items-center justify-between gap-2"><div class="flex items-center gap-2 min-w-0"><i class="fa-solid '+icon+' '+color+' text-base"></i><div class="min-w-0"><div class="font-medium flex items-center gap-1">'+name+fileStatus+'</div><div class="text-[10px] text-gray-500">'+escapeHtml(detail||'')+'</div>'+(links?'<div class="flex flex-wrap gap-x-2 gap-y-0.5">'+links+'</div>':'')+'</div></div></div>';
            };
            var attLinks = function(category, attachments){
              return (attachments||[]).map(function(attachment,index){
                var label = typeof attachment==='string'
                  ? (/^data:/i.test(attachment) ? 'Attachment '+(index+1) : attachment.split(/[?#]/)[0].split(/[\\/]/).pop())
                  : (attachment.name||'Attachment '+(index+1));
                label = label || 'Attachment '+(index+1);
                var safeLabel = escapeHtml(label);
                return '<button type="button" class="text-[10px] text-gray-500 hover:text-blue-700" title="Open attachment: '+safeLabel+'" aria-label="Open attachment: '+safeLabel+'" onclick="openProjectAttachment('+p.id+',\''+category+'\','+index+')"><i class="fa-solid fa-paperclip" aria-hidden="true"></i></button>';
              }).join('');
            };
            if (docs) docs.innerHTML = [
              docItem('Quotation', 'fa-file-invoice', 'text-emerald-600', !!(p.quoAttachments&&p.quoAttachments.length), has(p.quo)?p.quo:(p.quoAttachments?.length?p.quoAttachments.length+' file(s)':'Not set'), attLinks('quo',p.quoAttachments)),
              docItem('JF Approval', 'fa-file-signature', 'text-blue-600', !!(p.jfAttachments&&p.jfAttachments.length), has(p.jfRef)?p.jfRef:(p.jfAttachments?.length?p.jfAttachments.length+' file(s)':'Not set'), attLinks('jf',p.jfAttachments)),
              docItem('PREAPP', 'fa-file-circle-check', 'text-amber-600', !!(p.preappAttachments&&p.preappAttachments.length), has(p.preappRef)?p.preappRef:(p.preappAttachments?.length?p.preappAttachments.length+' file(s)':'Not attached'), attLinks('preapp',p.preappAttachments)),
              docItem('Picture', 'fa-images', 'text-indigo-600', picAtt.length>0, picAtt.length? (picAtt.length+' item(s)') : 'Not attached', attLinks('picture',picAtt)),
              docItem('P/Report', 'fa-file-lines', 'text-gray-600', !!(p.pReportAttachments&&p.pReportAttachments.length), has(p.pReport)?p.pReport:'Not set', attLinks('preport',p.pReportAttachments)),
              docItem('Claim', 'fa-file-invoice-dollar', 'text-rose-600', claimAtt.length>0, claimAtt.length?claimAtt.length+' file(s)':'Not attached', attLinks('status:DONE',claimAtt)),
            ].join('');

            var warns = [];
            if (!has(p.preappRef) && !(p.preappAttachments&&p.preappAttachments.length)) warns.push('PREAPP not attached');
            if (!has(p.quo) && !(p.quoAttachments&&p.quoAttachments.length)) warns.push('Quotation missing');
            if (!has(p.jfRef) && !(p.jfAttachments&&p.jfAttachments.length)) warns.push('JF missing');
            if (['PO','WOP','TENDER','DONE'].indexOf((p.status||'').toUpperCase()) !== -1 && !has(p.start)) warns.push('START date empty');
            if ((p.status||'').toUpperCase()==='DONE' && !has(p.finish)) warns.push('FINISH date empty');
            if ((p.status||'').toUpperCase()==='DONE' && !has(p.pReport)) warns.push('Completion/P report pending');
            var ready = warns.length===0;
            if (val) val.innerHTML =
              '<div class="p-2 rounded-lg border '+(ready?'border-green-200 bg-green-50':'border-amber-200 bg-amber-50')+'">' +
              '<div class="font-semibold '+(ready?'text-green-800':'text-amber-800')+'"><i class="fa-solid '+(ready?'fa-circle-check':'fa-triangle-exclamation')+' mr-1"></i>'+(ready?'Ready: key fields/docs present':'Checks & warnings')+'</div>' +
              (ready ? '<div class="text-green-700 text-xs mt-1">No missing key items detected by basic checks.</div>' : '<ul class="list-disc ml-5 mt-1 text-amber-700 text-xs space-y-1">'+warns.map(function(w){return '<li>'+escapeHtml(w)+'</li>';}).join('')+'</ul>') +
              '</div>';
        }

        // Hook into refreshDashboard to keep new views in sync
        var _origRefreshDashboard = refreshDashboard;
        refreshDashboard = function() {
            _origRefreshDashboard();
            try { renderNewDashboard(); if (document.getElementById('view-workflow') && document.getElementById('view-workflow').classList.contains('active')) { populateWorkflowSelect(); renderWorkflowView(); } } catch(e){ console.error('new ui refresh', e); }
        };


        // Fallback: ensure loading overlay never blocks UI
        window.addEventListener('load', function() {
            setTimeout(function() {
                var loader = document.getElementById('loader');
                if (loader) loader.classList.add('hidden');
            }, 4000);
        });
        setTimeout(function() {
            var loader = document.getElementById('loader');
            if (loader) loader.classList.add('hidden');
        }, 12000);

        // Always start at Dashboard on page load
        window.addEventListener('DOMContentLoaded', function() {
            switchView('dashboard');
        });

</script>
</body>
