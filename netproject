        async function loadStpAssetRecords() {
            if (isAppsScriptHost()) {
                try {
                    stpAssetRecords = await appsScriptCall('getStpAssetRecords');
                    const options = document.getElementById('stp-asset-options');
                    options.replaceChildren(...stpAssetRecords.map(record => {
                        const option = document.createElement('option');
                        option.value = record.asset;
                        option.textContent = record.asset;
                        return option;
                    }));
                    return;
                } catch (error) {
                    console.error('Failed to load STP records from Apps Script.', error);
                    showToast(error.message || 'Gagal memuatkan senarai STP dari Google Sheets.');
                    return;
                }
            }

            try {
                const response = await fetch('./STP LIST.csv');
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }
                if (typeof Papa === 'undefined') {
                    throw new Error('CSV parser is unavailable.');
                }

                const result = Papa.parse(await response.text(), { header: true, skipEmptyLines: true });
                if (result.errors.length) {
                    throw new Error(result.errors[0].message);
                }

                const getColumnValue = (row, columnName) => {
                    const key = Object.keys(row).find(header => header.trim().toLowerCase() === columnName.toLowerCase());
                    return key ? String(row[key] || '').trim() : '';
                };
                const dateInputValue = value => {
                    const match = String(value || '').trim().match(/^(\d{1,2})-([A-Za-z]{3})-(\d{2}|\d{4})$/);
                    if (!match) return toDateInputValue(value);

                    const month = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec']
                        .indexOf(match[2].toLowerCase());
                    if (month < 0) return '';

                    const day = Number(match[1]);
                    let year = Number(match[3]);
                    if (match[3].length === 2) year += year < 50 ? 2000 : 1900;
                    const date = new Date(Date.UTC(year, month, day));
                    if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month || date.getUTCDate() !== day) return '';
                    return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                };

                stpAssetRecords = result.data.map(row => ({
                    asset: getColumnValue(row, 'ASSET'),
                    assetLocation: getColumnValue(row, 'ASSET LOCATION'),
                    assetType: getColumnValue(row, 'ASSET TYPE'),
                    dateTakeover: dateInputValue(getColumnValue(row, 'TAKE OVER DATE')),
                    dpe: getColumnValue(row, 'DPE'),
                    cpe: getColumnValue(row, 'CPE')
                })).filter(record => record.asset);

                const options = document.getElementById('stp-asset-options');
                options.replaceChildren(...stpAssetRecords.map(record => {
                    const option = document.createElement('option');
                    option.value = record.asset;
                    return option;
                }));
                if (document.getElementById('edit-index').value === '-1') {
                    handleAssetInput();
                }
            } catch (error) {
                console.error('Gagal memuat senarai aset STP.', error);
                showToast('Gagal memuatkan senarai aset STP.');
            }
        }

        function handleAssetInput() {
            const assetValue = document.getElementById('form-asset').value.trim().toLowerCase();
