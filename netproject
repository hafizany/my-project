        function parsePictureList(value) {
            const text = String(value || '').trim();
            if (!text || text === '-') return [];
            if (text.startsWith('[')) {
                try {
                    const parsed = JSON.parse(text);
                    if (Array.isArray(parsed)) {
                        return parsed.filter(item =>
                            (typeof item === 'string' && item.trim()) ||
                            (item &&
                                typeof item.name === 'string' &&
                                ((typeof item.dataUrl === 'string' &&
                                    /^data:application\/pdf;base64,/i.test(item.dataUrl)) ||
                                    isUploadedAttachmentUrl(item.fileUrl)))
                        );
                    }
                } catch (error) {
                    if (!(error instanceof SyntaxError)) throw error;
                }
            }
            const parts = text.split(',').map(item => item.trim()).filter(Boolean);
            const pictures = [];
            for (let index = 0; index < parts.length; index += 1) {
                if (/^data:(?:image\/[^;]+|application\/pdf);base64$/i.test(parts[index]) && parts[index + 1]) {
                    pictures.push(`${parts[index]},${parts[index + 1]}`);
                    index += 1;
                } else {
                    pictures.push(parts[index]);
                }
            }
            return pictures;
        }

