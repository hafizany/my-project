        function repairCsvRows(rawRows) {
            if (!Array.isArray(rawRows) || rawRows.length === 0) return { headers: [], data: [] };

            const rows = rawRows
                .filter(row => Array.isArray(row) && row.some(value => String(value ?? '').trim() !== ''))
                .map(row => row.map(value => value == null ? '' : String(value)));

            if (rows.length === 0) return { headers: [], data: [] };

            const headerRow = rows[0].map(value => String(value).trim());
            const hasAddedDateColumn = headerRow.some(header => ['quo date', 'preapp date'].includes(header.toLowerCase()));
            const canonicalSet = new Set(CANONICAL_CSV_FIELD_ORDER.map(value => value.toLowerCase()));
            const legacySet = new Set(LEGACY_CSV_FIELD_ORDER.map(value => value.toLowerCase()));

            let headers = headerRow;
            if (!hasAddedDateColumn && headerRow.length === CANONICAL_CSV_FIELD_ORDER.length) {
                headers = CANONICAL_CSV_FIELD_ORDER.map((name, index) => headerRow[index] && headerRow[index].trim() ? headerRow[index].trim() : name);
            } else if (!hasAddedDateColumn && headerRow.length === LEGACY_CSV_FIELD_ORDER.length) {
                headers = [...LEGACY_CSV_FIELD_ORDER];
                if (headerRow.some(header => header.toLowerCase() === 'asset type')) {
                    headers[headers.indexOf('Plant Type')] = 'Asset Type';
                }
            }

            const headerHasCanonicalFields = headers.some(header => canonicalSet.has(String(header).trim().toLowerCase()));
            const headerHasLegacyFields = headers.some(header => legacySet.has(String(header).trim().toLowerCase()));
            if (!headerHasCanonicalFields && headerHasLegacyFields) {
                headers = [...CANONICAL_CSV_FIELD_ORDER];
            }

            const dataRows = rows.slice(1).map(row => {
                const normalized = Array.from({ length: headers.length }, () => '');
                const sourceLength = row.length;
                const source = row.length === LEGACY_CSV_FIELD_ORDER.length
                    ? row
                    : row.length === CANONICAL_CSV_FIELD_ORDER.length
                        ? row
                        : row;

                for (let index = 0; index < Math.min(source.length, normalized.length); index += 1) {
                    normalized[index] = source[index] ?? '';
                }

                if (!hasAddedDateColumn && row.length === LEGACY_CSV_FIELD_ORDER.length && headers.length === CANONICAL_CSV_FIELD_ORDER.length) {
                    const repaired = Array(CANONICAL_CSV_FIELD_ORDER.length).fill('');
                    LEGACY_CSV_FIELD_ORDER.forEach((fieldName, fieldIndex) => {
                        const destinationIndex = CANONICAL_CSV_FIELD_ORDER.indexOf(fieldName);
                        if (destinationIndex >= 0) {
                            repaired[destinationIndex] = row[fieldIndex] ?? '';
                        }
                    });
                    return repaired;
                }

                return normalized;
            });

            return {
                headers,
                data: dataRows.map(row => {
                    const objectRow = {};
                    headers.forEach((header, index) => {
                        objectRow[header] = row[index] ?? '';
                    });
                    return objectRow;
                })
            };
        }

        // Map exact CSV column names to standard fields
