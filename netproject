        function populateWorkflowSelect() {
            var sel = document.getElementById('wf-project-select');
            if (!sel) return;
            var cur = sel.value;
            var search = (document.getElementById('wf-project-search')?.value || '').trim().toLowerCase();
            var searchableFields = ['description', 'enq', 'asset', 'location', 'assetLocation', 'con', 'status'];
            var list = allProjects.filter(function(project){
                return !search || searchableFields.some(function(field){
                    return String(project[field] || '').toLowerCase().includes(search);
                });
            });
            sel.disabled = list.length === 0;
            if (!list.length) {
                sel.innerHTML = '<option value="">No projects found</option>';
                return;
            }
            sel.innerHTML = list.map(function(p){ return '<option value="'+p.id+'">['+escapeHtml(p.status||'')+'] '+escapeHtml((p.description||'-').slice(0,80))+' \u2014 '+escapeHtml(p.enq||'')+'</option>'; }).join('');
            if (cur && Array.prototype.some.call(sel.options, function(o){ return o.value===cur; })) sel.value = cur;
            if (!sel.value && sel.options.length) sel.selectedIndex = 0;
        }

