                    assetLocation: hasAssetLocationColumn
                        ? findExactOrPartial('Asset Location', ['asset location']) || '-'
                        : findExactOrPartial('Location', ['location', 'lokasi', 'tempat']) || '-',
                    asset: findExactOrPartial('Asset', ['asset']) || '-',
                    dpe: findExactOrPartial('DPE', ['dpe']) || '-',
