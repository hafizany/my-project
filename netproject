        function getTrackedProjectFormFields() {
            const projectForm = document.getElementById('project-form');
            if (!projectForm) return [];
            return Array.from(projectForm.querySelectorAll(PROJECT_FORM_TRACKED_FIELDS_SELECTOR))
                .filter(field => field.id !== 'edit-index' && !field.disabled);
        }

        function refreshProjectFormFieldStates() {
            const summary = document.getElementById('project-form-fill-summary');
            const fields = getTrackedProjectFormFields();
            let filledCount = 0;

            fields.forEach(field => {
                let filled;
                if (field.type === 'checkbox' || field.type === 'radio') {
                    filled = field.checked;
                } else {
                    filled = isMeaningfulFieldValue(field.value);
                }

                field.classList.toggle('field-state-filled', filled);
                field.classList.toggle('field-state-empty', !filled);
                if (filled) filledCount += 1;
            });

            if (summary) {
                summary.textContent = `Filled ${filledCount}/${fields.length} fields (${fields.length - filledCount} unfilled)`;
            }
        }

        function initializeProjectFormFieldStates() {
            const projectForm = document.getElementById('project-form');
            if (!projectForm || projectForm.dataset.fieldStateReady === 'true') return;

            const sync = event => {
                if (!event.target.closest('#project-form')) return;
                if (!event.target.matches(PROJECT_FORM_TRACKED_FIELDS_SELECTOR)) return;
                refreshProjectFormFieldStates();
            };

            projectForm.addEventListener('input', sync);
            projectForm.addEventListener('change', sync);
            projectForm.dataset.fieldStateReady = 'true';
            refreshProjectFormFieldStates();
        }

