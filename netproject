        function parseStatusAttachments(value) {
            if (!value || !value.trim()) return {};
            const parsed = JSON.parse(value);
            if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
                throw new Error('Status Attachments mesti mengandungi objek lampiran yang sah.');
            }
            for (const [status, attachments] of Object.entries(parsed)) {
                if (!STATUS_LIST.includes(status) || !validStoredAttachments(attachments)) {
                    throw new Error(`Lampiran status ${status} tidak sah.`);
