    <style id="jf-form-styles">
        .jf-paper { box-sizing: border-box; width: 297mm; min-height: 210mm; padding: 12mm 20.5mm 16mm; background: #fff; color: #111; font: 9pt Arial, Helvetica, sans-serif; }
