                    po: findExactOrPartial('PO', ['po']) || '-',
                    poDate: findExactOrPartial('PO date', ['po date', 'podate']) || '-',
                    signoffDate: findExactOrPartial('Signoff Date', ['signoff date']) || '-',
                    start: findExactOrPartial('START', ['start']) || '-',
                    finish: findExactOrPartial('FINISH', ['finish']) || '-',
                    remark: findExactOrPartial('remark', ['remark']) || '-',
                    _csvRow: { ...row }
                };
                const preappKey = keys.find(key => key.trim().toLowerCase() === 'preapp') ||
                    keys.find(key => key.trim().toLowerCase().includes('preapp') && key.trim().toLowerCase() !== 'preapp date');
                const preappValue = parsePreappValue(preappKey ? row[preappKey] : '');
                project.preappRef = preappValue.reference || '-';
                project.preappAttachments = preappValue.attachments;
                const quoValue = parseQuoValue(findExactOrPartial('Quo', ['quo']));
                project.quo = quoValue.reference || '-';
                project.quoAttachments = quoValue.attachments;
                const jfValue = parseJfValue(findExactOrPartial('JF', ['jf']));
                project.jfRef = jfValue.reference || '-';
                project.jfAttachments = jfValue.attachments;
                project._original = Object.fromEntries(
                    Object.keys(CSV_FIELD_HEADERS).map(field => [field, project[field]])
                );
                project._original.preappAttachments = project.preappAttachments.map(attachment => ({ ...attachment }));
                project._original.quoAttachments = project.quoAttachments.map(attachment => ({ ...attachment }));
                project._original.jfAttachments = project.jfAttachments.map(attachment => ({ ...attachment }));
                project._original.prAttachments = project.prAttachments.map(attachment => ({ ...attachment }));
                project._original.pReportAttachments = project.pReportAttachments.map(attachment => ({ ...attachment }));
                project._original.insAttachments = project.insAttachments.map(attachment => ({ ...attachment }));
                return project;
            });
        }

        function findCsvHeader(headers, candidates) {
            return headers.find(header =>
                candidates.some(candidate => header.trim().toLowerCase() === candidate.toLowerCase())
            );
        }

        function comparableFieldValue(field, value) {
            if (['date', 'preappDate', 'quoDate', 'poDate', 'kickoffMeetingDate', 'start', 'finish', 'signoffDate', 'dateTakeover', 'siteVisitDate'].includes(field)) {
                const clean = String(value ?? '').trim();
                if (field === 'date' && /^\d{4}$/.test(clean)) return clean;
                return toDateInputValue(value);
            }
            return String(value ?? '');
        }

        function buildCsvText() {
            const headers = [...csvHeaders];
            const hadAssetLocationColumn = Boolean(findCsvHeader(csvHeaders, CSV_FIELD_HEADERS.assetLocation));
            if (!findCsvHeader(headers, CSV_FIELD_HEADERS.quoDate)) {
                const quoHeader = findCsvHeader(headers, CSV_FIELD_HEADERS.quo);
                const quoIndex = quoHeader ? headers.indexOf(quoHeader) : -1;
                if (quoIndex >= 0) headers.splice(quoIndex + 1, 0, CSV_FIELD_HEADERS.quoDate[0]);
                else headers.push(CSV_FIELD_HEADERS.quoDate[0]);
            }
            if (!findCsvHeader(headers, CSV_FIELD_HEADERS.preappDate)) {
                const preappHeader = findCsvHeader(headers, CSV_FIELD_HEADERS.preappRef);
                const preappIndex = preappHeader ? headers.indexOf(preappHeader) : -1;
                if (preappIndex >= 0) headers.splice(preappIndex + 1, 0, CSV_FIELD_HEADERS.preappDate[0]);
                else headers.push(CSV_FIELD_HEADERS.preappDate[0]);
            }
            if (!findCsvHeader(headers, CSV_FIELD_HEADERS.kickoffMeetingDate)) {
                const startHeader = findCsvHeader(headers, CSV_FIELD_HEADERS.start);
                const startIndex = startHeader ? headers.indexOf(startHeader) : -1;
                if (startIndex >= 0) headers.splice(startIndex, 0, CSV_FIELD_HEADERS.kickoffMeetingDate[0]);
                else headers.push(CSV_FIELD_HEADERS.kickoffMeetingDate[0]);
            }
            if (!findCsvHeader(headers, CSV_FIELD_HEADERS.signoffDate)) {
                const finishHeader = findCsvHeader(headers, CSV_FIELD_HEADERS.finish);
                const finishIndex = finishHeader ? headers.indexOf(finishHeader) : -1;
                if (finishIndex >= 0) headers.splice(finishIndex + 1, 0, CSV_FIELD_HEADERS.signoffDate[0]);
                else headers.push(CSV_FIELD_HEADERS.signoffDate[0]);
            }
            if (!findCsvHeader(headers, CSV_FIELD_HEADERS.manhole)) {
                const pipeHeader = findCsvHeader(headers, CSV_FIELD_HEADERS.pipe);
                const pipeIndex = pipeHeader ? headers.indexOf(pipeHeader) : -1;
                if (pipeIndex >= 0) headers.splice(pipeIndex + 1, 0, CSV_FIELD_HEADERS.manhole[0]);
                else headers.push(CSV_FIELD_HEADERS.manhole[0]);
            }
            Object.values(CSV_FIELD_HEADERS).forEach(candidates => {
                if (!findCsvHeader(headers, candidates)) headers.push(candidates[0]);
            });

            const rows = allProjects.map(project => {
                const row = { ...(project._csvRow || {}) };
                Object.entries(CSV_FIELD_HEADERS).forEach(([field, candidates]) => {
                    const header = field === 'plantType'
                        ? findCsvHeader(headers, ['Asset Type']) || findCsvHeader(headers, candidates)
                        : findCsvHeader(headers, candidates);
                    const attachmentField = {
                        preappRef: 'preappAttachments',
                        quo: 'quoAttachments',
                        jfRef: 'jfAttachments'
                    }[field];
                    const unchanged = project._original &&
                        (field !== 'assetLocation' || hadAssetLocationColumn) &&
                        (attachmentField
                        ? comparableFieldValue(field, project[field]) ===
                            comparableFieldValue(field, project._original[field]) &&
                            JSON.stringify(project[attachmentField] || []) ===
                            JSON.stringify(project._original[attachmentField] || [])
                        : field === 'statusAttachments'
                            ? JSON.stringify(project.statusAttachments || {}) === JSON.stringify(project._original.statusAttachments || {})
                        : field === 'prAttachments'
                            ? JSON.stringify(project.prAttachments || []) === JSON.stringify(project._original.prAttachments || [])
                        : field === 'pReportAttachments'
                            ? JSON.stringify(project.pReportAttachments || []) === JSON.stringify(project._original.pReportAttachments || [])
                        : field === 'insAttachments'
                            ? JSON.stringify(project.insAttachments || []) === JSON.stringify(project._original.insAttachments || [])
                        :
                        comparableFieldValue(field, project[field]) ===
                        comparableFieldValue(field, project._original[field]));
                    if (!unchanged) {
                        row[header] = field === 'preappRef'
                            ? serializePreappValue(project.preappRef, project.preappAttachments)
                            : field === 'quo'
                                ? serializeQuoValue(project.quo, project.quoAttachments)
                                : field === 'jfRef'
                                    ? serializeJfValue(project.jfRef, project.jfAttachments)
                                : field === 'statusAttachments'
                                    ? Object.keys(project.statusAttachments || {}).length ? JSON.stringify(project.statusAttachments) : ''
                                : field === 'prAttachments'
                                    ? project.prAttachments && project.prAttachments.length ? JSON.stringify(project.prAttachments) : ''
                                : field === 'pReportAttachments'
                                    ? project.pReportAttachments && project.pReportAttachments.length
                                        ? JSON.stringify(project.pReportAttachments.map(({ name, dataUrl, fileUrl }) => ({ name, dataUrl, fileUrl })))
                                        : ''
                                : field === 'insAttachments'
                                    ? project.insAttachments && project.insAttachments.length
                                        ? JSON.stringify(project.insAttachments.map(({ name, dataUrl, fileUrl }) => ({ name, dataUrl, fileUrl })))
                                        : ''
                                : project[field] ?? '';
                    }
                });
                return headers.map(header => row[header] ?? '');
            });

            return Papa.unparse({ fields: headers, data: rows });
        }

        async function persistProjects() {
            if (isAppsScriptHost()) {
                var _st=document.getElementById('sync-status'); if(_st){ _st.textContent = `Menyimpan perubahan ke Google Sheets (${allProjects.length} rekod)...`; _st.title = _st.textContent; }
                await appsScriptCall('saveProjectsCsv', buildCsvText());
                var _st=document.getElementById('sync-status'); if(_st){ _st.textContent = `Google Sheets dikemaskini (${allProjects.length} rekod)`; _st.title = _st.textContent; }
                return;
            }

            const csvUrl = new URL(getCsvUrl(), window.location.href);
            if (csvUrl.origin !== window.location.origin || !csvUrl.pathname.toLowerCase().endsWith('.csv')) {
                throw new Error('Simpan hanya disokong untuk fail CSV tempatan dalam folder aplikasi.');
            }

            var _st=document.getElementById('sync-status'); if(_st){ _st.textContent = `Menyimpan perubahan ke CSV (${allProjects.length} rekod)...`; _st.title = _st.textContent; }
            const response = await fetch('/save-csv', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    path: csvUrl.pathname,
                    content: buildCsvText()
                })
            });
            const result = await response.json();
            if (!response.ok) {
                throw new Error(result.error || 'Gagal menyimpan fail CSV.');
            }
            var _st=document.getElementById('sync-status'); if(_st){ _st.textContent = `CSV disimpan (${allProjects.length} rekod)`; _st.title = _st.textContent; }
        }

        function toDateInputValue(value) {
            const clean = String(value || '').trim();
            if (/^\d{4}-\d{2}-\d{2}$/.test(clean)) return clean;
            const match = clean.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{4})$/);
            if (!match) return '';
            return `${match[3]}-${match[2].padStart(2, '0')}-${match[1].padStart(2, '0')}`;
        }

        function toEnquiryDateInputValue(value) {
            const clean = String(value || '').trim();
            return /^\d{4}$/.test(clean) ? clean : toDateInputValue(clean);
        }

        function normalizeEnquiryDate(value) {
            const clean = String(value || '').trim();
            return /^\d{4}$/.test(clean) ? clean : toDateInputValue(clean) || clean;
        }

        function isValidEnquiryDate(value) {
            const clean = String(value || '').trim();
            if (!clean || /^\d{4}$/.test(clean)) return true;
            const normalized = toDateInputValue(clean);
            if (!normalized) return false;
            const [year, month, day] = normalized.split('-').map(Number);
            const date = new Date(0);
            date.setUTCHours(0, 0, 0, 0);
            date.setUTCFullYear(year, month - 1, day);
            return date.getUTCFullYear() === year &&
                date.getUTCMonth() === month - 1 &&
                date.getUTCDate() === day;
        }

