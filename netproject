        function serializePdfReference(reference, attachments, storagePrefix) {
            const cleanReference = String(reference || '').trim();
            if (!attachments || attachments.length === 0) return cleanReference;
            return storagePrefix + JSON.stringify({
                reference: cleanReference,
                attachments: attachments.map(({ name, dataUrl, fileUrl }) => ({ name, dataUrl, fileUrl }))
            });
        }

        function serializePreappValue(reference, attachments) {
            return serializePdfReference(reference, attachments, PREAPP_PDF_STORAGE_PREFIX);
        }

        function serializeQuoValue(reference, attachments) {
            return serializePdfReference(reference, attachments, QUO_PDF_STORAGE_PREFIX);
        }

        function serializeJfValue(reference, attachments) {
            return serializePdfReference(reference, attachments, JF_PDF_STORAGE_PREFIX);
