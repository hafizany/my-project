        async function uploadPendingAttachments(attachments) {
            for (const attachment of attachments) {
                if (!attachment.file) continue;

                const file = attachment.file;

                if (isAppsScriptHost()) {
                    const dataUrl = await readFileAsDataUrl(file);
                    const base64 = dataUrl.split(',', 2)[1] || '';
                    const result = await appsScriptCall('uploadAttachmentToDrive', {
                        name: file.name,
                        mimeType: file.type || 'application/octet-stream',
                        base64
                    });
                    if (!result || typeof result !== 'object') {
                        throw new Error(`Respons muat naik untuk ${file.name} tidak sah.`);
                    }
                    if (!isUploadedAttachmentUrl(result.fileUrl) || typeof result.name !== 'string') {
                        throw new Error(`Respons muat naik untuk ${file.name} tidak sah.`);
                    }

                    attachment.name = result.name;
                    attachment.fileUrl = result.fileUrl;
                    delete attachment.file;
                    delete attachment.fileType;
                    continue;
                }

                const response = await fetch('/upload-attachment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': file.type || 'application/octet-stream',
                        'X-File-Name': encodeURIComponent(file.name)
                    },
                    body: file
                });
                const result = await response.json();
                if (!response.ok) {
                    throw new Error(result.error || `Gagal memuat naik ${file.name}.`);
                }
                if (!isUploadedAttachmentUrl(result.fileUrl) || typeof result.name !== 'string') {
                    throw new Error(`Respons muat naik untuk ${file.name} tidak sah.`);
                }

                attachment.name = result.name;
                attachment.fileUrl = result.fileUrl;
                delete attachment.file;
                delete attachment.fileType;
            }
        }

        async function saveProject(e) {
            e.preventDefault();
            if (isSavingProjects) return;
            const enquiryDateInput = document.getElementById('form-date');
            if (!isValidEnquiryDate(enquiryDateInput.value)) {
                enquiryDateInput.setCustomValidity('Enter a valid date or a year (YYYY).');
                enquiryDateInput.reportValidity();
                return;
            }
            const id = parseInt(document.getElementById('edit-index').value);
            const enquiry = document.getElementById('form-enq').value.trim().toLowerCase();
            const asset = document.getElementById('form-asset').value.trim().toLowerCase();
            const hasDuplicateKey = value => value && value !== '-' && value !== 'na';
            const possibleDuplicate = allProjects.find(project =>
                project.id !== id &&
                hasDuplicateKey(enquiry) &&
                hasDuplicateKey(asset) &&
                String(project.enq || '').trim().toLowerCase() === enquiry &&
                String(project.asset || '').trim().toLowerCase() === asset
            );
            if (possibleDuplicate && !window.confirm(
                `Another project already uses enquiry ${document.getElementById('form-enq').value.trim()} and asset ${document.getElementById('form-asset').value.trim()}. Save anyway?`
            )) return;

            isSavingProjects = true;
            const submitButton = document.querySelector('#project-form button[type="submit"]');
            if (submitButton) submitButton.disabled = true;
            try {
                await Promise.all([
                    uploadPendingAttachments(projectPictures),
                    ...Object.values(statusAttachments).map(uploadPendingAttachments),
                    uploadPendingAttachments(prAttachments),
                    uploadPendingAttachments(pReportAttachments),
                    uploadPendingAttachments(insAttachments),
                    uploadPendingAttachments(preappPdfAttachments),
                    uploadPendingAttachments(quoPdfAttachments),
                    uploadPendingAttachments(jfPdfAttachments)
                ]);
            } catch (error) {
                isSavingProjects = false;
                if (submitButton) submitButton.disabled = false;
                showToast(error.message || 'Gagal memuat naik lampiran.');
                console.error(error);
                return;
            }
            const previousProjects = allProjects.map(project => ({ ...project }));
            const newData = {
                description: document.getElementById('form-desc').value,
                status: document.getElementById('form-status').value,
                projectStatus: document.getElementById('form-project-status').value.trim() || '-',
                statusAttachments: Object.fromEntries(Object.entries(statusAttachments).map(
                    ([status, attachments]) => [status, attachments.map(({ name, dataUrl, fileUrl }) => ({ name, dataUrl, fileUrl }))]
                )),
                preappRef: document.getElementById('form-preapp').value,
                preappDate: document.getElementById('form-preapp-date').value,
                preappAttachments: preappPdfAttachments.map(attachment => ({ ...attachment })),
                enq: document.getElementById('form-enq').value,
                enqType: document.getElementById('form-enq-type').value,
                date: normalizeEnquiryDate(document.getElementById('form-date').value),
                con: document.getElementById('form-con').value,
                siteVisitDate: document.getElementById('form-site-visit-date').value || '-',
                quo: document.getElementById('form-quo').value,
                quoDate: document.getElementById('form-quo-date').value,
                quoAttachments: quoPdfAttachments.map(attachment => ({ ...attachment })),
                location: document.getElementById('form-location').value,
                assetLocation: document.getElementById('form-asset-location').value || '-',
                asset: document.getElementById('form-asset').value,
                dpe: document.getElementById('form-dpe').value || '-',
                cpe: document.getElementById('form-cpe').value || '-',
                plantType: document.getElementById('form-plant-type').value || '-',
                dateTakeover: document.getElementById('form-date-takeover').value || '-',
                length: document.getElementById('form-length').value || '-',
                width: document.getElementById('form-width').value || '-',
                depth: document.getElementById('form-depth').value || '-',
                pipe: document.getElementById('form-pipe').value || '-',
                manhole: document.getElementById('form-manhole').value || '-',
                duration: document.getElementById('form-duration').value || '-',
                matrix: document.getElementById('form-matrix').value || '-',
                risk: document.getElementById('form-risk').value,
                justificationForRepair: document.getElementById('form-justification-for-repair').value || '-',
                pReport: document.getElementById('form-preport').value,
                pReportAttachments: pReportAttachments.map(({ name, dataUrl, fileUrl }) => ({ name, dataUrl, fileUrl })),
                proposeAction: document.getElementById('form-propose-action').value || '-',
                ins: document.getElementById('form-ins').value,
                insAttachments: insAttachments.map(({ name, dataUrl, fileUrl }) => ({ name, dataUrl, fileUrl })),
                jfRef: document.getElementById('form-jf').value,
                jfAttachments: jfPdfAttachments.map(attachment => ({ ...attachment })),
                
                picture: serializePictureList(projectPictures),
                
                value: parseFloat(document.getElementById('form-value').value) || 0,
                not: document.getElementById('form-not').value,
                order: document.getElementById('form-order').value,
                pr: document.getElementById('form-pr').value,
                prAttachments: prAttachments.map(({ name, dataUrl, fileUrl }) => ({ name, dataUrl, fileUrl })),
                prDate: document.getElementById('form-pr-date').value,
                po: document.getElementById('form-po').value,
                poDate: document.getElementById('form-podate').value,
                kickoffMeetingDate: document.getElementById('form-kickoff-meeting-date').value || '-',
                start: document.getElementById('form-start').value,
                finish: document.getElementById('form-finish').value,
                signoffDate: document.getElementById('form-signoff-date').value || '-',
                remark: document.getElementById('form-remark').value
            };

            if (id === -1) {
                newData.id = allProjects.length > 0 ? Math.max(...allProjects.map(p => p.id)) + 1 : 1;
                allProjects.unshift(newData);
            } else {
                const idx = allProjects.findIndex(p => p.id === id);
                if (idx !== -1) {
                    allProjects[idx] = { ...allProjects[idx], ...newData };
                } else {
                    allProjects = previousProjects;
                    showToast('Rekod projek tidak ditemui.');
                    isSavingProjects = false;
                    if (submitButton) submitButton.disabled = false;
                    return;
                }
            }
            
            refreshDashboard();
            try {
                await persistProjects();
                closeModal();
                showToast(id === -1 ? 'Projek berjaya ditambah dan disimpan!' : 'Projek berjaya dikemas kini dan disimpan!');
            } catch (error) {
                allProjects = previousProjects;
                refreshDashboard();
                var _st=document.getElementById('sync-status'); if(_st){ _st.textContent = 'Gagal menyimpan CSV.'; _st.title = _st.textContent; }
                showToast(error.message || 'Gagal menyimpan fail CSV.');
                console.error(error);
            } finally {
                isSavingProjects = false;
                if (submitButton) submitButton.disabled = false;
            }
        }

