        // Extract Year & Month (YYYY, MM) from various date formats
        function extractYearMonth(dateStr) {
            if (!dateStr || dateStr === '-') return { year: '', month: '' };
            const clean = String(dateStr).trim();
            if (/^\d{4}$/.test(clean)) return { year: clean, month: '' };
            
            // Match YYYY-MM-DD or YYYY/MM/DD
            let m = clean.match(/^(\d{4})[-\/](\d{1,2})[-\/]\d{1,2}/);
            if (m) return { year: m[1], month: m[2].padStart(2, '0') };

            // Match DD/MM/YYYY or DD-MM-YYYY
            m = clean.match(/^\d{1,2}[-\/](\d{1,2})[-\/](\d{4})/);
            if (m) return { year: m[2], month: m[1].padStart(2, '0') };

            // Fallback to JS Date parser
            const parsed = new Date(clean);
            if (!isNaN(parsed.getTime())) {
                return {
                    year: String(parsed.getFullYear()),
                    month: String(parsed.getMonth() + 1).padStart(2, '0')
                };
            }
            return { year: '', month: '' };
        }

