        function renderDashKpis() {
            var total = allProjects.length;
            var done = allProjects.filter(function(p){ return (p.status||'').toUpperCase() === 'DONE'; }).length;
            var progress = allProjects.filter(function(p){ return ['PREAPP','QUO','JF','PR','PO','WOP','TENDER'].indexOf((p.status||'').toUpperCase()) !== -1; }).length;
            var attention = 0;
            allProjects.forEach(function(p){ if (needsAttention(p).length) attention++; });
            var val = (filteredProjects || []).reduce(function(s,p){ return s + (Number(p.value)||0); }, 0);
            var set = function(id, v){ var el = document.getElementById(id); if (el) el.textContent = v; };
            set('dash-total', total);
            set('dash-progress', progress);
            set('dash-done', done);
            set('dash-attention', attention);
            set('dash-value', 'RM ' + formatCurrency(val));
        }

        function needsAttention(p) {
            var issues = [];
            var st = (p.status||'').toUpperCase();
            if (!p.description || p.description === '-') issues.push('No description');
            if (st && st !== 'DONE' && st !== 'PREAPP') {
                if (!(p.quoAttachments && p.quoAttachments.length) && (!p.quo || p.quo === '-')) issues.push('Missing quotation');
                if (!p.jfRef || p.jfRef === '-') issues.push('Missing JF ref');
            }
            if (['PR','PO','WOP','TENDER'].indexOf(st) !== -1 && (!p.po || p.po === '-')) issues.push('Missing PO');
            if (st === 'PO' && (!p.start || p.start === '-')) issues.push('PO without START date');
            return issues;
        }

        function renderDashAttention() {
            var ul = document.getElementById('dash-attention-list');
            if (!ul) return;
            var items = [];
            allProjects.forEach(function(p){ var iss = needsAttention(p); if (iss.length) items.push({p:p, iss:iss}); });
            items.sort(function(a,b){ return b.iss.length - a.iss.length; });
            var top = items.slice(0, 12);
            if (!top.length) { ul.innerHTML = '<li class="text-gray-500">No issues detected.</li>'; return; }
            ul.innerHTML = top.map(function(x){
              var p=x.p, iss=x.iss;
              return '<li class="flex gap-3 items-start cursor-pointer hover:bg-gray-50 p-2 rounded" onclick="openWorkflowFor('+p.id+')">' +
                '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-red-100 text-red-700">'+iss.length+'</span>' +
                '<div class="min-w-0"><div class="font-semibold truncate" title="'+escapeHtml(p.description||'')+'">'+escapeHtml(p.description||'-')+'</div>' +
                '<div class="text-gray-500 text-xs">'+escapeHtml(iss.join(' \u00B7 '))+' <span class="ml-1 font-medium text-gray-700">['+escapeHtml(p.status||'')+']</span></div></div></li>';
            }).join('');
        }

        var _chartLoading = false;
        function renderDashCharts() {
            if (typeof Chart === 'undefined') {
                if (_chartLoading) return;
                _chartLoading = true;
                var s = document.createElement('script');
                s.src = 'https://cdn.jsdelivr.net/npm/chart.js';
                s.onload = function(){ _chartLoading = false; renderDashCharts(); };
