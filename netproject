            return rawRows.map((row, idx) => {
                const keys = Object.keys(row);
                const findExactOrPartial = (exactName, fallbacks = []) => {
                    const exactKey = keys.find(k => k.trim().toLowerCase() === exactName.toLowerCase());
                    if (exactKey) return (row[exactKey] || '').trim();
                    const partialKey = keys.find(k => fallbacks.some(p => k.trim().toLowerCase().includes(p)));
                    return partialKey ? (row[partialKey] || '').trim() : '';
                };

                const rawStatus = findExactOrPartial('Status', ['status']).toUpperCase();
                const status = STATUS_ALIASES[rawStatus] || rawStatus || 'PREAPP';
                const rawVal = findExactOrPartial('value', ['value', 'amount', 'harga']).replace(/[^0-9.-]+/g, '');
                const hasAssetLocationColumn = keys.some(key => key.trim().toLowerCase() === 'asset location');

                const project = {
                    id: idx + 1,
                    description: findExactOrPartial('Description', ['desc']) || '-',
                    status,
                    projectStatus: findExactOrPartial('Project Status') || '-',
                    statusAttachments: parseStatusAttachments(findExactOrPartial('Status Attachments')),
