            const printWindow = window.open('', '_blank', 'width=1200,height=900');
            if (!printWindow) {
                showToast('Pop-up blocked. Allow pop-ups to print or save the report as PDF.');
                return;
            }

            const reportRows = filteredProjects.map((project, index) => {
                const references = [
                    ['PREAPP', project.preappRef],
                    ['ENQ', project.enq],
                    ['QUO', project.quo],
                    ['RISK', project.risk],
                    ['P/REPORT', project.pReport],
                    ['INS', project.ins],
                    ['JF', project.jfRef],
                    ['NOT', project.not],
                    ['ORDER', project.order],
                    ['PR', project.pr],
                    ['PO', project.po]
                ].filter(([, value]) => value && value !== '-')
                    .map(([label, value]) => `${escapeHtml(label)}: ${escapeHtml(value)}`)
                    .join('<br>') || '-';
                const dates = [
                    ['PO Date', project.poDate],
                    ['Start', project.start],
                    ['Finish', project.finish]
                ].filter(([, value]) => value && value !== '-')
                    .map(([label, value]) => `${escapeHtml(label)}: ${escapeHtml(value)}`)
                    .join('<br>') || '-';

                return `<tr>
                    <td>${index + 1}</td>
                    <td><strong>${escapeHtml(project.description)}</strong><br>Location: ${escapeHtml(project.location)}<br>Contractor: ${escapeHtml(project.con)}</td>
                    <td>${references}</td>
                    <td>${escapeHtml(project.status)}</td>
                    <td>${escapeHtml(project.projectStatus && project.projectStatus !== '-' ? project.projectStatus : '-')}</td>
                    <td class="numeric">RM ${formatCurrency(project.value)}</td>
                    <td>${dates}</td>
                </tr>`;
            }).join('');
            const totalValue = filteredProjects.reduce((total, project) => total + (Number(project.value) || 0), 0);
            const reportStyles = `
                <style>
                    @page { size: A4 landscape; margin: 10mm; }
                    * { box-sizing: border-box; }
                    body { color: #1f2937; font: 10px Arial, Helvetica, sans-serif; margin: 0; }
                    h1 { color: #002b5c; font-size: 20px; margin: 0 0 6px; }
                    .meta { color: #4b5563; margin-bottom: 14px; }
                    table { border-collapse: collapse; width: 100%; }
                    th, td { border: 1px solid #cbd5e1; padding: 6px; text-align: left; vertical-align: top; }
                    th { background: #e8eef5; color: #002b5c; }
                    tr { break-inside: avoid; }
                    .numeric { text-align: right; white-space: nowrap; }
                    @media print { thead { display: table-header-group; } }
                </style>`;
            printWindow.document.write(`<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Project Report</title>${reportStyles}</head><body>
                <h1>Project Report</h1>
                <div class="meta">Generated: ${escapeHtml(new Date().toLocaleString())} &bull; Projects: ${filteredProjects.length} &bull; Total value: RM ${formatCurrency(totalValue)}</div>
                <table><thead><tr><th>No</th><th>Project</th><th>Document References</th><th>DOC STATUS</th><th>Project Status</th><th>Value (RM)</th><th>Dates</th></tr></thead><tbody>${reportRows}</tbody></table>
            </body></html>`);
            printWindow.document.close();
            printWindow.focus();
            setTimeout(() => printWindow.print(), 400);
        }

