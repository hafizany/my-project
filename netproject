        const PREAPP_PDF_STORAGE_PREFIX = '__PREAPP_PDF_V1__';
        const QUO_PDF_STORAGE_PREFIX = '__QUO_PDF_V1__';
        const JF_PDF_STORAGE_PREFIX = '__JF_PDF_V1__';

        function isUploadedAttachmentUrl(value) {
            if (typeof value !== 'string') return false;
            const trimmed = value.trim();
            return Boolean(trimmed) && (
                /^\/uploads\/[A-Za-z0-9._-]+$/.test(trimmed) ||
                /^https:\/\/(?:drive|docs)\.google\.com\//i.test(trimmed)
            );
        }

        function isImageAttachment(attachment) {
            if (!attachment || typeof attachment !== 'object') return false;
            const name = attachment.name || (attachment.file && attachment.file.name) || '';
            const fileType = attachment.fileType || (attachment.file && attachment.file.type) || '';
            return /^image\/(?:png|jpeg|gif|webp)$/i.test(fileType) ||
                /\.(?:png|jpe?g|gif|webp)$/i.test(name) ||
                /^data:image\/(?:png|jpeg|gif|webp);base64,/i.test(attachment.dataUrl || '');
        }

        function parsePdfReference(value, storagePrefix) {
            const text = String(value || '').trim();
            if (!text.startsWith(storagePrefix)) {
                return { reference: text, attachments: [] };
            }

            try {
                const parsed = JSON.parse(text.slice(storagePrefix.length));
                if (typeof parsed.reference !== 'string' || !Array.isArray(parsed.attachments)) {
                    throw new Error('Data lampiran PDF tidak sah.');
                }
                const attachments = parsed.attachments.filter(attachment =>
                    attachment &&
                    typeof attachment.name === 'string' &&
                    ((typeof attachment.dataUrl === 'string' &&
                        /^data:application\/pdf;base64,/i.test(attachment.dataUrl)) ||
                        isUploadedAttachmentUrl(attachment.fileUrl))
                );
                return { reference: parsed.reference, attachments };
            } catch (error) {
                console.error('Gagal membaca lampiran PDF.', error);
                return { reference: text, attachments: [] };
            }
        }

        function parsePreappValue(value) {
            return parsePdfReference(value, PREAPP_PDF_STORAGE_PREFIX);
