        function parseTermContractorDate(value) {
            const text = String(value || '').trim();
            const dateText = text.includes('|') ? text.split('|').pop().trim() : text;
            const dottedDate = dateText.match(/^(\d{1,2})\.(\d{1,2})\.(\d{4})$/);
            const normalized = dottedDate
                ? `${dottedDate[3]}-${dottedDate[2].padStart(2, '0')}-${dottedDate[1].padStart(2, '0')}`
                : toDateInputValue(dateText);
            if (!normalized) return null;

            const [year, month, day] = normalized.split('-').map(Number);
            const timestamp = Date.UTC(year, month - 1, day);
            const parsed = new Date(timestamp);
            if (parsed.getUTCFullYear() !== year ||
                parsed.getUTCMonth() !== month - 1 ||
                parsed.getUTCDate() !== day) {
                return null;
            }
            return timestamp;
        }

        function calculateTermContractorLosDays(enquiryValue, prDateValue) {
            const enquiryDate = parseTermContractorDate(enquiryValue);
            const prDate = parseTermContractorDate(prDateValue);
            if (enquiryDate === null || prDate === null) return null;
            return (prDate - enquiryDate) / 86400000;
        }

