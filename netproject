                dateTakeover: document.getElementById('form-date-takeover'),
                dpe: document.getElementById('form-dpe'),
                cpe: document.getElementById('form-cpe')
            };
            const clearUnchangedAutofilledValues = () => {
                if (!lastAutoFilledAsset) return;
                Object.entries(fields).forEach(([key, field]) => {
                    if (field.value === lastAutoFilledAsset.values[key]) field.value = '';
                });
            };

            if (!match) {
                clearUnchangedAutofilledValues();
                lastAutoFilledAsset = null;
                return;
            }

            if (lastAutoFilledAsset && lastAutoFilledAsset.asset.toLowerCase() !== match.asset.toLowerCase()) {
                clearUnchangedAutofilledValues();
            }
            const values = {
                assetLocation: match.assetLocation,
                assetType: match.assetType,
                dateTakeover: match.dateTakeover,
                dpe: match.dpe,
                cpe: match.cpe
            };
            Object.entries(fields).forEach(([key, field]) => {
                field.value = values[key];
            });
            lastAutoFilledAsset = { asset: match.asset, values };
        }

