        // Update Contractor Value Summary Table
        function updateContractorSummary() {
            const tbody = document.getElementById('contractor-summary-body');
            const tfoot = document.getElementById('contractor-summary-foot');
            const contractorFilter = document.getElementById('summary-contractor-filter')?.value || 'ALL';
            const yearFilter = document.getElementById('summary-year-filter')?.value || 'ALL';
            const monthFilter = document.getElementById('summary-month-filter')?.value || 'ALL';
            const statusFilter = document.getElementById('summary-status-filter')?.value || 'ALL';

            const summaryMap = {};
            let grandTotal = 0;
            let totalProjectsCount = 0;

            allProjects.forEach(p => {
                if (statusFilter !== 'ALL' && p.status.toUpperCase() !== statusFilter) return;

                if (yearFilter !== 'ALL' || monthFilter !== 'ALL') {
                    const { year, month } = extractYearMonth(p.poDate);
                    if (yearFilter !== 'ALL' && year !== yearFilter) return;
                    if (monthFilter !== 'ALL' && month !== monthFilter) return;
                }

                const name = (p.con && p.con !== '-') ? p.con : 'Tiada Kontraktor';
                if (contractorFilter !== 'ALL' && name !== contractorFilter) return;

                const val = Number(p.value) || 0;
                if (!summaryMap[name]) {
                    summaryMap[name] = { total: 0, count: 0 };
                }
                summaryMap[name].total += val;
                summaryMap[name].count += 1;
                grandTotal += val;
                totalProjectsCount += 1;
            });

            // Sorting logic
            const entries = Object.entries(summaryMap);
            entries.sort((a, b) => {
                let valA, valB;
                if (summarySortCol === 'contractor') {
                    valA = a[0].toLowerCase();
                    valB = b[0].toLowerCase();
                } else if (summarySortCol === 'count') {
                    valA = a[1].count;
                    valB = b[1].count;
                } else {
                    valA = a[1].total;
                    valB = b[1].total;
                }

                if (valA < valB) return summarySortDir === 'asc' ? -1 : 1;
                if (valA > valB) return summarySortDir === 'asc' ? 1 : -1;
                return 0;
            });

            // Update Sort Icons
            ['contractor', 'count', 'value'].forEach(col => {
                const icon = document.getElementById(`sort-icon-${col}`);
                if (icon) {
                    icon.className = 'fas fa-sort ml-1 text-blue-300/50 text-xs'; // default inactive
                    if (col === summarySortCol) {
                        icon.className = summarySortDir === 'asc' 
                            ? 'fas fa-sort-up ml-1 text-white text-xs' 
                            : 'fas fa-sort-down ml-1 text-white text-xs';
                    }
                }
            });

            const countBadge = document.getElementById('contractor-count-badge');
            const totalBadge = document.getElementById('summary-total-badge');
            if (countBadge) countBadge.textContent = `${entries.length} Kontraktor \u2022 ${totalProjectsCount} Projek`;
            if (totalBadge) totalBadge.textContent = `Total: RM ${formatCurrency(grandTotal)}`;

            if (entries.length === 0) {
                tbody.innerHTML = `<tr><td colspan="3" class="py-3 px-4 text-center text-gray-400">Tiada data kontraktor sepadan</td></tr>`;
                if (tfoot) tfoot.classList.add('hidden');
                return;
            }

            tbody.innerHTML = entries.map(([contractor, info]) => `
                <tr class="hover:bg-blue-50/50 cursor-pointer transition-colors" onclick="filterByContractor('${contractor.replace(/'/g, "\\'")}')">
                    <td class="py-2 px-4 text-left font-medium text-gray-800 border-r border-gray-200">
                        <span class="truncate max-w-[150px] sm:max-w-[250px] inline-block align-middle" title="${escapeHtml(contractor)}">${escapeHtml(contractor)}</span>
                    </td>
                    <td class="py-2 px-4 text-center font-medium text-gray-800 border-r border-gray-200">
                        ${info.count}
                    </td>
                    <td class="py-2 px-4 text-right font-medium text-gray-800">
                        RM ${formatCurrency(info.total)}
                    </td>
                </tr>
            `).join('');

            if (tfoot) {
                tfoot.classList.remove('hidden');
                document.getElementById('summary-footer-count').textContent = totalProjectsCount;
                document.getElementById('summary-footer-total').textContent = `RM ${formatCurrency(grandTotal)}`;
            }
        }

